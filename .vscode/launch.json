{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "client: edge",
      // this should point to your Nuxt `srcDir`, which is `app` by default
      "serverReadyAction": {
        "pattern": ".*Vite client warmed up.*",
        "uriFormat": "http://localhost:8080/",
        "action": "debugWithEdge",
        "webRoot": "${workspaceFolder}/app",
      },
      "preLaunchTask": "Nuxt: Debug"
    },  
  ]
}
